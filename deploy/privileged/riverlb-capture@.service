[Unit]
Description=RiverLB bounded diagnostic capture %i
BindsTo=riverlb-privileged.service
After=riverlb-privileged.service

[Service]
Type=exec
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/libexec/riverlb/privileged/capture_worker.py %i
StandardInput=null
StandardOutput=null
StandardError=null
TimeoutStopSec=2s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
ProtectHome=yes
ProtectSystem=strict
RuntimeDirectory=riverlb-captures/%i
RuntimeDirectoryMode=0700
ReadWritePaths=/run/riverlb-captures/%i
RuntimeMaxSec=670s
InaccessiblePaths=-/run/riverlb-privileged -/run/riverlb -/run/riverlb-ha-deploy -/etc/shadow -/etc/gshadow -/etc/riverlb -/var/lib/riverlb -/etc/riverlb-privileged -/var/lib/riverlb-privileged -/var/lib/riverlb-updater -/var/lib/pcsd -/var/lib/pacemaker
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_NETLINK AF_PACKET
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @module @raw-io @obsolete @debug @cpu-emulation memfd_create
SystemCallErrorNumber=EPERM
Nice=10
CPUQuota=10%
MemoryMax=128M
TasksMax=8
LimitNOFILE=32
LimitCORE=0
LimitCPU=5
LimitAS=128M
LimitFSIZE=16M
