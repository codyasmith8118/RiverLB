[Unit]
Description=RiverLB appliance (HA standby at boot)
After=network-online.target firewalld.service
Wants=network-online.target riverlb-privileged.service
Requires=riverlb-privileged-prepare.service
After=riverlb-privileged.service riverlb-privileged-prepare.service

[Service]
Type=simple
User=riverlb
Group=riverlb
UMask=0077
# Repair restored/RPM-owned paths before non-root appliance conditions.
ExecCondition=+/usr/libexec/riverlb/privileged/prepare.py
ExecStart=/usr/bin/riverlb serve --privileged --config /etc/riverlb/riverlb.toml --database /var/lib/riverlb/riverlb.db --ha-config /etc/riverlb-privileged/ha.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=90s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/riverlb /var/lib/riverlb /run/riverlb -/mnt/riverlb-backups
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/dev/shm
OpenFile=/proc/1/ns/net:riverlb-host-netns:read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @module @raw-io @obsolete @debug @cpu-emulation memfd_create
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
