#!/usr/bin/env python3
"""Bind the image's bootstrap profile once; never offer it to an added NIC."""
import configparser
from pathlib import Path
import re
import os
import tempfile
import subprocess


def bind(root=Path('/')):
    profile = root / 'etc/NetworkManager/system-connections/riverlb-bootstrap.nmconnection'
    if not profile.exists():
        return
    config = configparser.ConfigParser(interpolation=None)
    config.read(profile)
    if config['connection'].get('interface-name') and config['ethernet'].get('mac-address'):
        return
    for nic in sorted((root / 'sys/class/net').iterdir()):
        if not (nic / 'device').exists() or (nic / 'type').read_text().strip() != '1':
            continue
        mac = (nic / 'address').read_text().strip()
        if not re.fullmatch(r'(?:[0-9a-f]{2}:){5}[0-9a-f]{2}', mac) or mac == '00:00:00:00:00:00':
            continue
        config['connection']['interface-name'] = nic.name
        config['connection']['autoconnect'] = 'true'
        config['ethernet']['mac-address'] = mac
        with tempfile.NamedTemporaryFile(mode='w', dir=profile.parent, delete=False) as output:
            temporary = Path(output.name)
            try:
                os.fchmod(output.fileno(), 0o600)
                config.write(output)
                output.flush()
                os.fsync(output.fileno())
                temporary.replace(profile)
            finally:
                temporary.unlink(missing_ok=True)
        return
    raise RuntimeError('No Ethernet adapter found for RiverLB bootstrap networking')


if __name__ == '__main__':
    bind()
    subprocess.run(['restorecon','-F','/etc/NetworkManager/system-connections/riverlb-bootstrap.nmconnection'],check=True)
