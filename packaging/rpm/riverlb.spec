Name:           riverlb
Version:        %{riverlb_version}
Release:        %{riverlb_release}%{?dist}
Summary:        RiverLB traffic management appliance
License:        MIT
Source0:        riverlb-payload.tar.gz
ExclusiveArch:  x86_64
Requires:       systemd
Requires:       iputils
Requires:       iproute
Requires:       firewalld
Requires:       openssl
Requires:       python3
Requires:       NetworkManager
Requires:       policycoreutils
Requires:       selinux-policy-targeted
# The payload is compiled/tested in the matching AlmaLinux container.
# Runtime ELF dependencies are generated by RPM.
%global debug_package %{nil}
# Private SDKs must not claim or require packages in the system Python namespace.
%global __requires_exclude_from ^%{_prefix}/lib/riverlb/fencing/.*$
%global __provides_exclude_from ^%{_prefix}/lib/riverlb/fencing/.*$

%description
RiverLB traffic management and administration. Installation does not start the
service or create an administrator. Configure management access before exposure.

%package ha
Summary:        Optional RiverLB active/standby integration
License:        MIT AND GPL-2.0-or-later AND Apache-2.0 AND BSD-3-Clause AND PSF-2.0 AND MPL-2.0
Requires:       %{name}%{?_isa} = %{version}-%{release}
Requires:       pacemaker
Requires:       corosync
Requires:       pcs
Requires:       resource-agents
Requires:       fence-agents-all
Requires:       fence-agents-common >= 4.16.0
Requires:       fence-agents-aws
Requires:       fence-agents-azure-arm
Requires:       fence-agents-gce
Requires:       fence-agents-openstack
Requires:       fence-agents-nutanix-ahv
Requires:       fence-agents-virsh
Requires:       python3-setuptools
Requires:       corosync-qdevice
Requires:       policycoreutils-python-utils
Requires:       hostname
Requires:       shadow-utils
Requires:       openssh-server
Requires:       openssh-clients
Requires:       python3

%description ha
Pacemaker resource agent and cluster helpers. Configure quorum, node identity,
SSH trust and suitable fencing separately. No cluster is created automatically.

%package appliance
Summary:        RiverLB appliance console initial setup
Requires:       %{name}%{?_isa} = %{version}-%{release}
Requires:       python3
Requires:       NetworkManager-tui
Requires:       policycoreutils

%description appliance
Console setup for unique administrator credentials, recovery access and device
HTTPS identity. Enabled only by the appliance image recipe, never by RPM install.

%prep
%setup -q -n riverlb-payload

%build
# Compilation occurs before payload creation, with Cargo.lock enforced.

%install
install -D -m 0755 riverlb %{buildroot}%{_prefix}/lib/riverlb/base/riverlb
install -D -m 0755 riverlb-launcher %{buildroot}%{_bindir}/riverlb
install -D -m 0755 riverlb-audit-security %{buildroot}%{_libexecdir}/riverlb/riverlb-audit-security
install -D -m 0755 riverlb-update %{buildroot}%{_libexecdir}/riverlb/riverlb-update
install -D -m 0644 riverlb-update.service %{buildroot}%{_unitdir}/riverlb-update.service
install -D -m 0644 riverlb-update-recovery.service %{buildroot}%{_unitdir}/riverlb-update-recovery.service
install -d -m 0755 %{buildroot}%{_prefix}/lib/riverlb/versions %{buildroot}%{_localstatedir}/lib/riverlb-updater %{buildroot}%{_sysconfdir}/riverlb-updater
install -m 0644 update-trust.json %{buildroot}%{_sysconfdir}/riverlb-updater/update-trust.json
install -d -m 0700 %{buildroot}%{_sysconfdir}/riverlb %{buildroot}%{_localstatedir}/lib/riverlb
install -m 0600 riverlb.toml %{buildroot}%{_sysconfdir}/riverlb/riverlb.toml
install -D -m 0644 riverlb.service %{buildroot}%{_unitdir}/riverlb.service
install -D -m 0644 riverlb-sandbox.cil %{buildroot}%{_datadir}/selinux/packages/riverlb-sandbox.cil
install -D -m 0755 riverlb-setup %{buildroot}%{_sbindir}/riverlb-setup
install -D -m 0755 riverlb-brand-appliance %{buildroot}%{_libexecdir}/riverlb/riverlb-brand-appliance
install -D -m 0755 riverlb-bootstrap-network %{buildroot}%{_libexecdir}/riverlb/riverlb-bootstrap-network
install -D -m 0644 riverlb-bootstrap-network.service %{buildroot}%{_unitdir}/riverlb-bootstrap-network.service
install -D -m 0644 riverlb-network-defaults.conf %{buildroot}%{_sysconfdir}/NetworkManager/conf.d/90-riverlb-network-defaults.conf
install -D -m 0644 release-stage %{buildroot}%{_datadir}/riverlb/release-stage
install -D -m 0644 riverlb-firstboot.service %{buildroot}%{_unitdir}/riverlb-firstboot.service
install -D -m 0644 firstboot-gate.conf %{buildroot}%{_unitdir}/riverlb.service.d/firstboot-gate.conf
install -D -m 0644 riverlb-ha.service %{buildroot}%{_unitdir}/riverlb-ha.service
# Prevent simultaneous standalone and HA service starts in either direction.
install -d %{buildroot}%{_unitdir}/riverlb-ha.service.d
install -D -m 0755 riverlb-ha-deploy %{buildroot}%{_libexecdir}/riverlb/riverlb-ha-deploy
install -D -m 0755 fence_pve %{buildroot}%{_sbindir}/fence_pve
install -D -m 0755 fence_riverlb_hyperv %{buildroot}%{_sbindir}/fence_riverlb_hyperv
install -D -m 0755 fence_riverlb_openstack %{buildroot}%{_sbindir}/fence_riverlb_openstack
install -d -m 0755 %{buildroot}%{_prefix}/lib/riverlb/fencing
cp -a openstack-sdk %{buildroot}%{_prefix}/lib/riverlb/fencing/openstack
install -d -m 0755 %{buildroot}%{_datadir}/riverlb/ha
cp -a hyperv %{buildroot}%{_datadir}/riverlb/ha/
for unit in riverlb-ha-deploy.service riverlb-ha-activate.service riverlb-ha-sshd.service; do
    install -D -m 0644 "$unit" %{buildroot}%{_unitdir}/"$unit"
done
install -D -m 0644 riverlb-ha-tmpfiles.conf %{buildroot}%{_tmpfilesdir}/riverlb-ha.conf
printf '[Unit]\nConflicts=riverlb.service\n[Service]\nWorkingDirectory=/var/lib/riverlb\n' > %{buildroot}%{_unitdir}/riverlb-ha.service.d/packaging.conf
install -D -m 0755 riverlb-cluster %{buildroot}%{_libexecdir}/riverlb/riverlb-cluster
install -D -m 0755 riverlb-authority %{buildroot}%{_libexecdir}/riverlb/riverlb-authority
install -D -m 0755 riverlb-traffic %{buildroot}%{_prefix}/lib/ocf/resource.d/riverlb/traffic

%post
%{_sbindir}/semodule -i %{_datadir}/selinux/packages/riverlb-sandbox.cil || exit $?
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :

%preun
if [ "$1" -eq 0 ]; then
    %{_bindir}/systemctl --no-reload disable --now riverlb.service >/dev/null 2>&1 || :
fi

%postun
if [ "$1" -eq 0 ]; then
    %{_sbindir}/semodule -r riverlb-sandbox || :
fi
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :

%post ha
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :
%{_bindir}/systemd-tmpfiles --create %{_tmpfilesdir}/riverlb-ha.conf >/dev/null 2>&1 || :

%preun ha
if [ "$1" -eq 0 ]; then
    %{_bindir}/systemctl --no-reload disable --now riverlb-ha.service riverlb-ha-sshd.service >/dev/null 2>&1 || :
fi

%postun ha
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :

%files
%license LICENSE
%doc README.md build-manifest.json
%{_bindir}/riverlb
%{_unitdir}/riverlb.service
%{_datadir}/selinux/packages/riverlb-sandbox.cil
%{_unitdir}/riverlb-update.service
%{_unitdir}/riverlb-update-recovery.service
%dir %{_prefix}/lib/riverlb
%dir %{_prefix}/lib/riverlb/base
%dir %{_prefix}/lib/riverlb/versions
%{_prefix}/lib/riverlb/base/riverlb
%dir %{_datadir}/riverlb
%{_datadir}/riverlb/release-stage
%dir %{_libexecdir}/riverlb
%{_libexecdir}/riverlb/riverlb-update
%{_libexecdir}/riverlb/riverlb-audit-security
%dir %attr(0755,root,root) %{_sysconfdir}/riverlb-updater
%config(noreplace) %attr(0644,root,root) %{_sysconfdir}/riverlb-updater/update-trust.json
%dir %attr(0755,root,root) %{_localstatedir}/lib/riverlb-updater
%dir %attr(0700,root,root) %{_sysconfdir}/riverlb
%config(noreplace) %attr(0600,root,root) %{_sysconfdir}/riverlb/riverlb.toml
%dir %attr(0700,root,root) %{_localstatedir}/lib/riverlb

%files ha
%doc high-availability.md
%doc fence-agents-source
%doc openstack-requirements.txt
%license fence-agents-source/COPYING.applications
%{_sbindir}/fence_pve
%{_sbindir}/fence_riverlb_hyperv
%{_sbindir}/fence_riverlb_openstack
%{_prefix}/lib/riverlb/fencing/
%{_datadir}/riverlb/ha/
%{_unitdir}/riverlb-ha.service
%{_unitdir}/riverlb-ha.service.d/
%{_libexecdir}/riverlb/riverlb-cluster
%{_libexecdir}/riverlb/riverlb-authority
%{_libexecdir}/riverlb/riverlb-ha-deploy
%{_unitdir}/riverlb-ha-deploy.service
%{_unitdir}/riverlb-ha-activate.service
%{_unitdir}/riverlb-ha-sshd.service
%{_tmpfilesdir}/riverlb-ha.conf
%{_prefix}/lib/ocf/resource.d/riverlb/

%post appliance
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :
# Load the new-NIC policy without restarting networking or existing connections.
if %{_bindir}/systemctl is-active --quiet NetworkManager.service; then
    %{_bindir}/nmcli general reload conf >/dev/null 2>&1 || :
fi

%preun appliance
if [ "$1" -eq 0 ]; then
    %{_bindir}/systemctl --no-reload disable --now riverlb-firstboot.service >/dev/null 2>&1 || :
    %{_bindir}/systemctl --no-reload disable --now riverlb-bootstrap-network.service >/dev/null 2>&1 || :
fi

%postun appliance
%{_bindir}/systemctl daemon-reload >/dev/null 2>&1 || :

%files appliance
%{_sbindir}/riverlb-setup
%{_libexecdir}/riverlb/riverlb-brand-appliance
%{_libexecdir}/riverlb/riverlb-bootstrap-network
%{_unitdir}/riverlb-bootstrap-network.service
%config(noreplace) %{_sysconfdir}/NetworkManager/conf.d/90-riverlb-network-defaults.conf
%{_unitdir}/riverlb-firstboot.service
%{_unitdir}/riverlb.service.d/firstboot-gate.conf
