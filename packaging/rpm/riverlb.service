[Unit]
Description=RiverLB traffic manager
After=network-online.target firewalld.service riverlb-update-recovery.service
Wants=network-online.target riverlb-privileged.service
Requires=riverlb-update-recovery.service riverlb-privileged-prepare.service
After=riverlb-privileged.service riverlb-privileged-prepare.service
Conflicts=riverlb-ha.service

[Service]
Type=simple
User=riverlb
Group=riverlb
UMask=0077
WorkingDirectory=/var/lib/riverlb
# RPM replacement/console restore can reset directory ownership while the
# preparation dependency remains active. Repair before appliance conditions,
# which run as riverlb and need to enter the working directory.
ExecCondition=+/usr/libexec/riverlb/privileged/prepare.py
ExecStartPre=+/usr/libexec/riverlb/riverlb-update preflight
ExecStart=/usr/bin/riverlb serve --privileged --config /etc/riverlb/riverlb.toml --database /var/lib/riverlb/riverlb.db
Restart=on-failure
RestartSec=2s
TimeoutStopSec=90s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/riverlb /var/lib/riverlb /run/riverlb -/mnt/riverlb-backups
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/dev/shm
# Verify the host network namespace without CAP_SYS_PTRACE or CAP_SYS_ADMIN.
OpenFile=/proc/1/ns/net:riverlb-host-netns:read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @module @raw-io @obsolete @debug @cpu-emulation memfd_create
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
