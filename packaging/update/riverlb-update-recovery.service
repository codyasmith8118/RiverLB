[Unit]
Description=RiverLB interrupted application update recovery
Before=riverlb.service
[Service]
Type=oneshot
RemainAfterExit=yes
User=root
UMask=0077
ExecStart=/usr/libexec/riverlb/riverlb-update preflight
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/usr/lib/riverlb /var/lib/riverlb /var/lib/riverlb-updater
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
