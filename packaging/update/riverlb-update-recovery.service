[Unit]
Description=RiverLB interrupted application update recovery
Before=riverlb.service
[Service]
Type=oneshot
RemainAfterExit=yes
User=root
UMask=0077
ExecStart=/usr/libexec/riverlb/riverlb-update preflight
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/usr/lib/riverlb /var/lib/riverlb /var/lib/riverlb-updater /var/lib/riverlb-updater-work
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
