#!/usr/bin/python3 -I
"""Fixed-operation signed standalone updater; recovery runs before every start."""
import base64
import fcntl
import hashlib
import json
import os
from pathlib import Path
import socket
import struct
import shutil
import re
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager

BASE = Path('/usr/lib/riverlb/base/riverlb')
CURRENT = Path('/usr/lib/riverlb/current')
VERSIONS = Path('/usr/lib/riverlb/versions')
DB = Path('/var/lib/riverlb/riverlb.db')
CONFIG = Path('/etc/riverlb/riverlb.toml')
BUNDLE = DB.with_suffix('.update-bundle.json')
UPDATER = Path('/var/lib/riverlb-updater')
WORK = Path('/var/lib/riverlb-updater-work')
JOURNAL = UPDATER / 'recovery.json'
CHECKPOINT = UPDATER / 'checkpoint.json'
HIGHSTATE = UPDATER / 'status.json'
RUNNING = UPDATER / 'running.json'
TRUST = Path('/etc/riverlb-updater/update-trust.json')
SOCKET = Path('/run/riverlb/operations.sock')
HELPER = Path('/usr/libexec/riverlb/riverlb-update')
OWNER = 0
BROKER_POLICY = Path('/etc/riverlb-privileged/policy.json')
MAX_BUNDLE = 180 * 1024 * 1024
MAX_CHECKPOINT = 32 * 1024 * 1024


def service_owner():
    if not BROKER_POLICY.exists():
        return OWNER  # Legacy, pre-migration recovery and repository fixtures.
    value = load(BROKER_POLICY)
    owner = value.get('uid')
    if type(owner) is not int or owner <= 0:
        raise RuntimeError('Invalid installed service identity')
    return owner


def run(args):
    # Do not inherit loader, Python, shell or proxy overrides from the caller.
    result = subprocess.run([str(a) for a in args], check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=90, text=True,
                            env={'PATH': '/usr/sbin:/usr/bin', 'LANG': 'C.UTF-8'})
    return result.stdout


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def secure_directory(path, owner=None):
    owner = OWNER if owner is None else owner
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != owner or info.st_mode & 0o022
            or path.resolve() != path.absolute()):
        raise RuntimeError('Unsafe updater directory')


def secure_file(path, owner=None):
    owner = OWNER if owner is None else owner
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != owner
                or info.st_mode & 0o022 or info.st_nlink != 1):
            raise RuntimeError('Unsafe updater file')
    finally:
        os.close(fd)


def write(path, data):
    secure_directory(path.parent)
    if path.exists() or path.is_symlink():
        secure_file(path)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.riverlb-update-')
    try:
        with os.fdopen(fd, 'w') as output:
            json.dump(data, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, path)
        sync_directory(path.parent)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def load(path, owner=None):
    owner = OWNER if owner is None else owner
    secure_directory(path.parent, owner)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != owner
                or info.st_mode & 0o022 or info.st_nlink != 1
                or info.st_size > MAX_BUNDLE):
            raise RuntimeError('Unsafe or oversized update state')
        with os.fdopen(fd, 'r') as source:
            fd = None
            return json.load(source)
    finally:
        if fd is not None:
            os.close(fd)


def copy_staged_bundle(destination):
    """Bounded byte copy; never parse app-controlled JSON in the root copier."""
    owner = service_owner()
    secure_directory(BUNDLE.parent, owner)
    secure_directory(destination.parent)
    descriptor = os.open(BUNDLE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as source:
        info = os.fstat(source.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != owner or info.st_nlink != 1
                or info.st_mode & 0o022 or info.st_size > MAX_BUNDLE):
            raise RuntimeError('Unsafe or oversized staged bundle')
        with destination.open('xb') as output:
            total = 0
            while True:
                chunk = source.read(min(1024 * 1024, MAX_BUNDLE + 1 - total))
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_BUNDLE:
                    raise RuntimeError('Staged bundle grew beyond its bound')
                output.write(chunk)
            output.flush()
            os.fsync(output.fileno())
    sync_directory(destination.parent)


@contextmanager
def application_workspace():
    secure_directory(WORK)
    identity = load(BROKER_POLICY)
    owner, group = identity['uid'], identity['gid']
    if type(owner) is not int or type(group) is not int or owner <= 0 or group <= 0:
        raise RuntimeError('Invalid application workspace identity')
    with tempfile.TemporaryDirectory(dir=WORK, prefix='operation-') as directory:
        os.chown(directory, owner, group)
        yield Path(directory)


def run_application(args):
    identity = load(BROKER_POLICY)
    # Database engines and certificate/configuration parsers consume app-owned
    # data without root authority. Their output never becomes an executable.
    subprocess.run([str(value) for value in args], check=True, timeout=90,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   user=identity['uid'], group=identity['gid'], extra_groups=[],
                   env={'PATH': '/usr/sbin:/usr/bin', 'LANG': 'C.UTF-8'}, close_fds=True)


def cleanup_workspaces():
    if not BROKER_POLICY.exists():
        return
    secure_directory(WORK)
    for path in WORK.iterdir():
        if not re.fullmatch(r'operation-[a-z0-9_]{8}', path.name):
            raise RuntimeError('Unexpected updater workspace requires console inspection')
        secure_directory(path, service_owner())
        shutil.rmtree(path)  # Python's descriptor-based implementation rejects links.
    sync_directory(WORK)


def copy_checkpoint(source, destination, source_owner, destination_owner, parent_owner):
    secure_directory(source.parent, source_owner)
    secure_directory(destination.parent, parent_owner)
    descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, 'rb') as incoming:
        info = os.fstat(incoming.fileno())
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != source_owner or info.st_nlink != 1
                or info.st_mode & 0o077 or info.st_size > MAX_CHECKPOINT):
            raise RuntimeError('Unsafe checkpoint transfer')
        output_fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(output_fd, 'wb') as output:
            total = 0
            while True:
                chunk = incoming.read(min(1024 * 1024, MAX_CHECKPOINT + 1 - total))
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_CHECKPOINT:
                    raise RuntimeError('Checkpoint transfer exceeds its bound')
                output.write(chunk)
            output.flush()
            os.fchown(output.fileno(), destination_owner, -1)
            os.fsync(output.fileno())
    sync_directory(destination.parent)


def checkpoint_database(reader):
    if not BROKER_POLICY.exists():
        run([reader, 'backup', '--database', DB, '--output', CHECKPOINT])
        return load(CHECKPOINT)
    with application_workspace() as directory:
        snapshot = directory / 'checkpoint.json'
        run_application([reader, 'backup', '--database', DB, '--output', snapshot])
        copy_checkpoint(snapshot, CHECKPOINT, service_owner(), OWNER, OWNER)
    return None  # Root does not parse private app-controlled snapshot contents.


def remove(path):
    if path.exists() or path.is_symlink():
        secure_file(path, service_owner() if path == BUNDLE else OWNER)
        path.unlink()
        sync_directory(path.parent)


def version_path(target):
    target = Path(target)
    if target.parent != VERSIONS or not target.name.isascii() or not target.name.isdigit():
        raise RuntimeError('Invalid application recovery path')
    secure_directory(VERSIONS)
    secure_directory(target)
    secure_file(target / 'riverlb')
    return target


def previous_reader():
    secure_directory(CURRENT.parent)
    secure_directory(BASE.parent)
    secure_file(BASE)
    if not CURRENT.exists() and not CURRENT.is_symlink():
        return None, BASE
    if not CURRENT.is_symlink():
        raise RuntimeError('Invalid current application selector')
    previous = version_path(os.readlink(CURRENT))
    return str(previous), previous / 'riverlb'


def point(target):
    secure_directory(CURRENT.parent)
    link = CURRENT.with_name('.riverlb-current-new')
    if link.exists() or link.is_symlink():
        # This name is updater-owned; do not remove an unexpected ordinary file.
        if not link.is_symlink():
            raise RuntimeError('Conflicting application selector')
        link.unlink()
    if target is None:
        if CURRENT.exists() or CURRENT.is_symlink():
            if not CURRENT.is_symlink():
                raise RuntimeError('Invalid current application selector')
            CURRENT.unlink()
    else:
        target = version_path(target)
        os.symlink(target, link)
        os.replace(link, CURRENT)
    sync_directory(CURRENT.parent)


@contextmanager
def exclusive_lock(path, owner=None):
    owner = OWNER if owner is None else owner
    secure_directory(path.parent, owner)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid not in {OWNER, owner}
                or info.st_mode & 0o077 or info.st_nlink != 1):
            raise RuntimeError('Unsafe updater lock')
        if info.st_uid != owner:
            os.fchown(fd, owner, -1)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally:
        os.close(fd)


def restore_database(reader):
    # The previous validated application understands its own checkpoint schema.
    # This companion lock also refuses manual recovery against a live daemon.
    owner = service_owner()
    with exclusive_lock(Path(str(DB) + '.lock'), owner):
        secure_file(DB, owner)
        workspace = application_workspace() if BROKER_POLICY.exists() else tempfile.TemporaryDirectory(dir=UPDATER, prefix='.riverlb-rollback-')
        with workspace as directory:
            restored = Path(directory) / 'restored.db'
            if BROKER_POLICY.exists():
                source = Path(directory) / 'checkpoint.json'
                copy_checkpoint(CHECKPOINT, source, OWNER, owner, owner)
                run_application([reader, 'restore', '--database', restored, '--input', source])
            else:
                run([reader, 'restore', '--database', restored, '--input', CHECKPOINT])
            secure_file(restored, owner)
            for suffix in ('-wal', '-shm'):
                old = Path(str(DB) + suffix)
                if old.exists() or old.is_symlink():
                    secure_file(old, owner)
                    old.unlink()
            os.chown(restored, owner, -1)
            os.replace(restored, DB)
            for suffix in ('-wal', '-shm'):
                source = Path(str(restored) + suffix)
                if source.exists():
                    secure_file(source, owner)
                    os.chown(source, owner, -1)
                    os.replace(source, Path(str(DB) + suffix))
            sync_directory(DB.parent)


def state_read():
    state = load(HIGHSTATE) if HIGHSTATE.exists() else {'highest_sequence': 0, 'history': []}
    if (not isinstance(state.get('highest_sequence'), int) or state['highest_sequence'] < 0
            or not isinstance(state.get('history'), list)):
        raise RuntimeError('Invalid privileged update status')
    return state


def state_write(state):
    write(HIGHSTATE, state)
    os.chmod(HIGHSTATE, 0o644)


def recover():
    if not JOURNAL.exists() and not JOURNAL.is_symlink():
        return
    journal = load(JOURNAL)
    if (journal.get('format') != 1 or not isinstance(journal.get('sequence'), int)
            or journal['sequence'] <= 0):
        raise RuntimeError('Unknown update recovery journal')
    previous = journal.get('previous')
    reader = version_path(previous) / 'riverlb' if previous is not None else BASE
    secure_file(reader)
    if journal.get('reader', str(reader)) != str(reader):
        raise RuntimeError('Recovery reader does not match previous application')
    # Persist the sequence even if interruption occurred before its initial write.
    state = state_read()
    state['highest_sequence'] = max(state['highest_sequence'], journal['sequence'])
    state_write(state)
    restore_database(reader)
    point(previous)
    state['history'] = (state['history'] + [dict(time=int(time.time()), version=journal['version'],
                         sequence=journal['sequence'], result='rolled_back',
                         message='Previous application and compatible database restored')])[-100:]
    state_write(state)
    remove(BUNDLE)
    remove(JOURNAL)  # Clear only after database, selector and history are durable.


def local_status():
    owner = service_owner()
    secure_directory(SOCKET.parent, owner)
    info = SOCKET.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != owner or info.st_mode & 0o077:
        raise RuntimeError('Unsafe local readiness socket')
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(2)
        connection.connect(str(SOCKET))
        peer = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer[1] != owner:
            raise RuntimeError('Unexpected local readiness peer')
        connection.sendall(b'{"action":"status"}\n')
        response = bytearray()
        while b'\n' not in response:
            chunk = connection.recv(16384)
            if not chunk or len(response) + len(chunk) > 2 * 1024 * 1024:
                raise RuntimeError('Invalid local readiness response')
            response.extend(chunk)
    status = json.loads(response)
    if 'error' in status:
        raise RuntimeError('Local readiness unavailable')
    return status


def readiness(snapshot, baseline, manifest):
    if snapshot is None:
        revision, config = baseline['revision'], dict(management=baseline['management'])
    else:
        rows = snapshot['tables']['configurations']
        revision, config = max(rows, key=lambda row: row[0])[:2]
        config = json.loads(config)
    required = {v['name'] for v in baseline['virtual_servers'] if v['enabled'] and v['state'] == 'up'}
    for _ in range(30):
        try:
            status = local_status()
            actual = {v['name']: v for v in status['virtual_servers']}
            if (status['version'] == manifest['version'] and status['revision'] == revision
                    and status['management'] == config['management']
                    and status['management_secure'] == baseline['management_secure']
                    and not status['confirmation_pending'] and status['ha_role'] == 'standalone'
                    and all(actual.get(name, {}).get('state') == 'up' for name in required)):
                return
        except (OSError, ValueError, KeyError, RuntimeError):
            pass
        time.sleep(1)
    raise RuntimeError('Management or previously healthy virtual-server readiness failed')


def activate():
    secure_directory(UPDATER)
    secure_directory(DB.parent, service_owner())
    previous, reader = previous_reader()
    if Path('/etc/riverlb/ha.json').exists() or Path('/etc/riverlb-privileged/ha.json').exists():
        raise RuntimeError('HA activation requires rolling-update qualification')
    if DB.with_suffix('.confirmation.json').exists():
        raise RuntimeError('Confirm pending configuration before updating')
    if JOURNAL.exists() or JOURNAL.is_symlink():
        raise RuntimeError('Recover the interrupted update before starting another')
    platform = {}
    for line in Path('/etc/os-release').read_text().splitlines():
        if '=' in line:
            key, value = line.split('=', 1)
            platform[key] = value.strip(chr(34))
    if platform.get('ID') != 'almalinux' or not platform.get('VERSION_ID', '').startswith('10.'):
        raise RuntimeError('This offline bundle supports AlmaLinux 10 x86-64 appliances')
    state = state_read()
    # Copy untrusted staging bytes into a root-private directory before signature
    # verification. The service UID cannot replace or modify the verified copy.
    with tempfile.TemporaryDirectory(dir=UPDATER, prefix='.riverlb-update-') as directory:
        copy = Path(directory) / 'bundle.json'
        copy_staged_bundle(copy)
        manifest = json.loads(run([reader, 'update-verify', '--bundle', copy,
                                  '--trust', TRUST, '--sequence', state['highest_sequence']]))
        payload = base64.b64decode(load(copy)['payload'], validate=True)
        if (len(payload) != manifest['payload_length']
                or hashlib.sha256(payload).hexdigest() != manifest['payload_sha256']):
            raise RuntimeError('Verified update payload changed before installation')
        version = VERSIONS / str(manifest['sequence'])
        secure_directory(VERSIONS)
        version.mkdir(mode=0o755, exist_ok=True)
        secure_directory(version)
        os.chmod(version, 0o755)
        binary = version / 'riverlb'
        if binary.exists() or binary.is_symlink():
            secure_file(binary)
            if hashlib.sha256(binary.read_bytes()).hexdigest() != manifest['payload_sha256']:
                raise RuntimeError('Conflicting staged version')
        else:
            with binary.open('xb') as output:
                output.write(payload)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(binary, 0o755)
        sync_directory(version)
        sync_directory(VERSIONS)
        if run([binary, '--version']).strip() != 'riverlb ' + manifest['version']:
            raise RuntimeError('Payload version does not match signed metadata')
        if BROKER_POLICY.exists() and run([binary, 'privileged-protocol']).strip() != '1':
            raise RuntimeError('Signed payload does not support the installed privileged protocol')
    baseline = local_status()
    if baseline['ha_role'] != 'standalone' or baseline['confirmation_pending']:
        raise RuntimeError('Only a confirmed standalone appliance can activate an update')
    try:
        run(['/usr/bin/systemctl', 'stop', 'riverlb.service'])
        remove(CHECKPOINT)
        snapshot = checkpoint_database(reader)
        journal = dict(format=1, previous=previous, reader=str(reader), version=manifest['version'],
                       sequence=manifest['sequence'])
        write(JOURNAL, journal)
        state['highest_sequence'] = manifest['sequence']
        state_write(state)
        point(version)
        run(['/usr/bin/systemctl', 'start', 'riverlb.service'])
        readiness(snapshot, baseline, manifest)
        state['history'] = (state['history'] + [dict(time=int(time.time()), version=manifest['version'],
                              sequence=manifest['sequence'], result='applied')])[-100:]
        state_write(state)
        remove(BUNDLE)
        remove(JOURNAL)
    except BaseException:
        if JOURNAL.exists():
            run(['/usr/bin/systemctl', 'stop', 'riverlb.service'])
            recover()
        run(['/usr/bin/systemctl', 'start', 'riverlb.service'])
        raise


def active_updater():
    try:
        marker = load(RUNNING)
        pid = marker['pid']
        if not isinstance(pid, int) or pid <= 0:
            return False
        process = Path('/proc') / str(pid)
        args = (process / 'cmdline').read_bytes().split(b'\0')
        return (process.stat().st_uid == OWNER and str(HELPER).encode() in args
                and b'activate' in args)
    except (OSError, ValueError, KeyError, RuntimeError):
        return False


def main(action):
    os.umask(0o077)
    if action == 'activate' or JOURNAL.exists() or JOURNAL.is_symlink():
        secure_directory(DB.parent, service_owner())
    secure_directory(UPDATER)
    try:
        with exclusive_lock(UPDATER / 'update.lock'):
            if action == 'activate':
                write(RUNNING, {'pid': os.getpid()})
                try:
                    activate()
                finally:
                    remove(RUNNING)
            else:
                recover()
                cleanup_workspaces()
                remove(RUNNING)
    except BlockingIOError:
        if action == 'preflight' and active_updater():
            return  # The real updater intentionally starts the candidate/rollback.
        raise RuntimeError('An update or live database operation is already in progress')


if __name__ == '__main__':
    if os.geteuid() != 0 or sys.argv[1:] not in (['activate'], ['recover'], ['preflight']):
        sys.exit('Run the installed updater as root with activate, recover or preflight.')
    try:
        main(sys.argv[1])
    except BaseException as error:
        # Never log private checkpoints, command output or credential material.
        message = ('A fixed update operation failed' if isinstance(error, subprocess.CalledProcessError)
                   else str(error)[:300])
        print('RiverLB update failed:', type(error).__name__, message, file=sys.stderr)
        sys.exit(1)
