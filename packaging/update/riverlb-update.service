[Unit]
Description=RiverLB signed offline application update
After=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/libexec/riverlb/riverlb-update activate
TimeoutStartSec=900
NoNewPrivileges=yes
# Fixed root file operations and explicit UID/GID drop for database tools.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/usr/lib/riverlb /var/lib/riverlb /var/lib/riverlb-updater /var/lib/riverlb-updater-work
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
